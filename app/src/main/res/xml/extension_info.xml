<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    id="ride-replay"
    displayName="@string/extension_name"
    icon="@android:drawable/ic_media_play"
    configurable="true"
    fitFile="false"
    scansDevices="true">

    <!-- scansDevices="true" is REQUIRED for Karoo OS to invoke startScan()
         on our service; without it the virtual sensors never appear in the
         Sensors → Add Sensor page. Confirmed by comparing against
         lockevod/Karoo-KPower's extension_info.xml + Hammerhead's sample
         extension, both of which declare it. -->

    <DataType
        description="@string/field_replay_description"
        displayName="@string/field_replay_name"
        graphical="true"
        icon="@drawable/ic_field_play"
        typeId="replay" />

</ExtensionInfo>
